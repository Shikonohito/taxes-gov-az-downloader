# Nine digits after +994. Spaces and hyphens are allowed.
ASAN_PHONE=

# Six-digit Asan İmza user ID.
ASAN_USER_ID=

# VÖEN of the required cabinet. Leave blank to select a cabinet manually.
TAXPAYER_TIN=

DOWNLOAD_DIR=downloads
BROWSER_PROFILE_DIR=.browser-profile

# chromium, chrome, or msedge. Install Chromium with:
# npx playwright install chromium
BROWSER_CHANNEL=chromium

# Five minutes for Asan İmza confirmation and three minutes per export.
AUTH_TIMEOUT_MS=300000
DOWNLOAD_TIMEOUT_MS=180000
SLOW_MO_MS=0
