# Девять цифр после +994. Пробелы и дефисы допустимы.
ASAN_PHONE=

# Шестизначный ID Asan İmza.
ASAN_USER_ID=

# VÖEN нужного кабинета. Если оставить пустым, кабинет выбирается вручную.
TAXPAYER_TIN=

DOWNLOAD_DIR=downloads
BROWSER_PROFILE_DIR=.browser-profile

# chromium, chrome или msedge. Chromium устанавливается командой:
# npx playwright install chromium
BROWSER_CHANNEL=chromium

# Пять минут на подтверждение Asan İmza и три минуты на каждый экспорт.
AUTH_TIMEOUT_MS=300000
DOWNLOAD_TIMEOUT_MS=180000
SLOW_MO_MS=0
